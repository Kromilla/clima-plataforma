# ── Telegram (obligatorio) ────────────────────────────────────────────────────
# Token de @BotFather y tu chat_id (obtenlo con: python dia1_chatid.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OpenAQ (obligatorio hoy, aunque sin cobertura local) ──────────────────────
# https://explore.openaq.org/account
# NOTA: la validación del Día 1 confirmó que OpenAQ NO tiene estaciones en Santa
# Marta ni en Barranquilla (ninguna en toda la costa Caribe). Se conserva como
# fuente secundaria por si algún día suman cobertura.
OPENAQ_API_KEY=

# ── Opcionales ────────────────────────────────────────────────────────────────
# Electricity Maps — NO se usa. La fuente de energía activa es XM, que es gratis
# y no requiere key. Déjalo vacío salvo que contrates Electricity Maps.
ELECTRICITY_MAPS_KEY=

# Ajustes de comportamiento (tienen defaults razonables; descoméntalos si quieres cambiarlos)
# UMBRAL_PM25_DEFAULT=50.0
# POLLING_INTERVALO_SEG=900
# DB_PATH=clima.db
# LOG_FILE=bot.log
